# VeriDB environment
#
# Copy to `.env` and fill in real values. `.env` is gitignored, so credentials
# never reach the repository.
#
#   cp .env.example .env
#
# VeriDB resolves credentials at runtime from these variables. Every `*_env`
# field in configs/veridb.yaml names one of them, and a `${VAR}` written in a
# config field is substituted from the same environment.

# ---------------------------------------------------------------------------
# Database connections
# ---------------------------------------------------------------------------
# IMPORTANT: keep this file at mode 0600. It is the only place the credentials
# exist on disk, and the repository does not need them in the shell environment.
#
#   cp .env.example .env && chmod 600 .env
#
# A single connection can serve every database on one host: {database} is
# replaced with each physical database name.
VERIDB_PRIMARY_DSN=postgres://USER:PASSWORD@HOST:PORT/{database}

# The same server expressed as parts, if you prefer not to keep a DSN:
VERIDB_PRIMARY_HOST=HOST
VERIDB_PRIMARY_PORT=PORT
VERIDB_PRIMARY_USER=USER
VERIDB_PRIMARY_PASSWORD=PASSWORD

# A single database without a placeholder:
# VERIDB_LOCAL_DSN=postgres://dev:dev@localhost:5432/{database}

# ---------------------------------------------------------------------------
# Audit viewer (docker compose)
# ---------------------------------------------------------------------------
# Shared secret for the audit UI. Anyone with this token can read your audit
# trail, so treat it like a password. Generate one with:
#   openssl rand -hex 24
VIEWER_TOKEN=CHANGE_ME

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=CHANGE_ME

# Local port the viewer is published on.
VIEWER_PORT=8080
# ngrok's local API port.
NGROK_API_PORT=4040
# How long a viewer API response may be reused.
VIEWER_CACHE_TTL=5s
# How often the viewer polls the JSONL trail.
VIEWER_INTERVAL=2s
